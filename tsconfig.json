{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@widgentic/core": [
        "./packages/core/src/index.ts"
      ],
      "@widgentic/core/*": [
        "./packages/core/src/*/index.ts"
      ],
      "@widgentic/designer": [
        "./packages/designer/src/index.ts"
      ],
      "@widgentic/designer/browser": [
        "./packages/designer/src/browser.ts"
      ],
      "@widgentic/webmcp": [
        "./packages/webmcp/src/index.ts"
      ],
      "@widgentic/mcp/authoring": [
        "./packages/mcp/src/authoring/index.ts"
      ],
      "@widgentic/mcp": [
        "./packages/mcp/src/index.ts"
      ],
      "@widgentic/mcp/sdk": [
        "./packages/mcp/src/server/server.ts"
      ],
      "@widgentic/mcp/store/sqlite": [
        "./packages/mcp/src/store/sqlite.ts"
      ],
      "@widgentic/mcp/store": [
        "./packages/mcp/src/store/index.ts"
      ],
      "@widgentic/mcp/store/cosmos": [
        "./packages/mcp/src/store/cosmos.ts"
      ],
      "@widgentic/mcp/secrets": [
        "./packages/mcp/src/secrets/index.ts"
      ],
      "@widgentic/mcp/secrets/keyvault": [
        "./packages/mcp/src/secrets/keyvault.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "examples/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist"
  ]
}
