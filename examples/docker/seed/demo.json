  "widgets": [
    {
      "kind": "appointment-agenda-widget",
      "template": {
        "tag": "section",
        "attrs": {
          "class": "wg-panel wg-agenda"
        },
        "children": [
          {
            "tag": "header",
            "attrs": {
              "class": "wg-panel-head"
            },
            "children": [
              {
                "tag": "h2",
                "attrs": {
                  "class": "wg-title"
                },
                "children": [
                  "Agenda"
                ]
              },
              {
                "when": "date",
                "template": {
                  "tag": "p",
                  "attrs": {
                    "class": "wg-date"
                  },
                  "children": [
                    {
                      "bind": "date",
                      "format": {
                        "type": "date",
                        "pattern": "yyyy-MM-dd"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "each": "appointments",
            "key": "id",
            "empty": {
              "tag": "p",
              "attrs": {
                "class": "wg-muted"
              },
              "children": [
                "No appointments."
              ]
            },
            "template": {
              "tag": "article",
              "attrs": {
                "class": {
                  "bind": "status",
                  "map": {
                    "cancelled": "wg-item wg-item-cancelled"
                  },
                  "default": "wg-item"
                }
              },
              "children": [
                {
                  "tag": "h3",
                  "attrs": {
                    "class": "wg-subtitle"
                  },
                  "children": [
                    {
                      "tag": "span",
                      "attrs": {
                        "class": "wg-subtitle-text"
                      },
                      "children": [
                        {
                          "bind": "title"
                        }
                      ]
                    },
                    {
                      "tag": "span",
                      "attrs": {
                        "class": {
                          "bind": "status",
                          "map": {
                            "confirmed": "wg-status wg-status-success",
                            "tentative": "wg-status wg-status-warning",
                            "cancelled": "wg-status wg-status-danger"
                          },
                          "default": "wg-status wg-status-info"
                        }
                      },
                      "children": [
                        {
                          "bind": "status"
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "wg-date"
                  },
                  "children": [
                    {
                      "bind": "startsAt",
                      "format": {
                        "type": "date",
                        "pattern": "yyyy-MM-dd HH:mm"
                      }
                    },
                    " — ",
                    {
                      "bind": "endsAt",
                      "format": {
                        "type": "date",
                        "pattern": "HH:mm"
                      }
                    }
                  ]
                },
                {
                  "when": "location",
                  "template": {
                    "tag": "p",
                    "attrs": {
                      "class": "wg-muted"
                    },
                    "children": [
                      {
                        "bind": "location"
                      }
                    ]
                  }
                },
                {
                  "when": "meetingUrl",
                  "template": {
                    "tag": "a",
                    "attrs": {
                      "class": "wg-link",
                      "href": {
                        "bind": "meetingUrl"
                      }
                    },
                    "children": [
                      "Join meeting"
                    ]
                  }
                },
                {
                  "when": "attendees",
                  "template": {
                    "tag": "ul",
                    "attrs": {
                      "class": "wg-list"
                    },
                    "children": [
                      {
                        "each": "attendees",
                        "template": {
                          "tag": "li",
                          "attrs": {
                            "class": {
                              "bind": "response",
                              "map": {
                                "accepted": "wg-chip wg-chip-yes",
                                "tentative": "wg-chip wg-chip-maybe",
                                "declined": "wg-chip wg-chip-no"
                              },
                              "default": "wg-chip"
                            }
                          },
                          "children": [
                            {
                              "when": "email",
                              "template": {
                                "tag": "a",
                                "attrs": {
                                  "class": "wg-link",
                                  "href": {
                                    "bind": "email",
                                    "prefix": "mailto:"
                                  }
                                },
                                "children": [
                                  {
                                    "bind": "name"
                                  }
                                ]
                              },
                              "else": {
                                "bind": "name"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "descriptor": {
        "description": "Displays a day agenda with formatted appointment times, attendance, and email links for attendees.",
        "dataShape": "{ date?, timezone?, appointments: [{ id, title, startsAt, endsAt, location?, meetingUrl?, description?, status, attendees?: [{ name, email?, response? }] }] }",
        "dataSchemaRef": "appointment-agenda",
        "dataExample": {
          "appointments": [
            {
              "attendees": [
                {
                  "email": "nora@example.com",
                  "name": "Nora Patel",
                  "response": "accepted"
                },
                {
                  "email": "sam@example.com",
                  "name": "Sam Lee",
                  "response": "tentative"
                }
              ],
              "endsAt": "2026-09-03T10:00:45",
              "id": "a-101",
