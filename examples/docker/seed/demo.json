{
  "schemas": [
    {
      "description": "A dated agenda containing scheduled appointments, participants, locations, and attendance state.",
      "label": "Appointment agenda",
      "name": "appointment-agenda",
      "schema": {
        "properties": {
          "appointments": {
            "items": {
              "properties": {
                "attendees": {
                  "items": {
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "response": {
                        "enum": [
                          "accepted",
                          "declined",
                          "tentative",
                          "needsAction"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "description": {
                  "type": "string"
                },
                "endsAt": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "meetingUrl": {
                  "type": "string"
                },
                "startsAt": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "tentative",
                    "cancelled"
                  ],
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "startsAt",
                "endsAt",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "date": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "appointments"
        ],
        "type": "object"
      }
    },
    {
      "description": "A mailbox with account context and an ordered collection of email messages.",
      "label": "Email inbox",
      "name": "email-inbox",
      "schema": {
        "properties": {
          "account": {
            "type": "string"
          },
          "messages": {
            "items": {
              "properties": {
                "from": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "isRead": {
                  "type": "boolean"
                },
                "isStarred": {
                  "type": "boolean"
                },
                "labels": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "preview": {
                  "type": "string"
                },
                "receivedAt": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "from",
                "subject",
                "receivedAt",
                "isRead"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "unreadCount": {
            "type": "integer"
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      }
    }
  ],
  "themes": [
    {
      "description": "A dark theme inspired by Google's deep surfaces and signature blue, red, yellow, and green accents.",
      "label": "Google-inspired dark",
      "name": "google-dark",
      "tokens": {
        "accent": "#8ab4f8",
        "accent-fg": "#202124",
        "bg": "#202124",
        "border": "#5f6368",
        "border-width": "1px",
        "danger": "#f28b82",
        "danger-fg": "#202124",
        "fg": "#e8eaed",
        "font-family": "Google Sans, Roboto, Arial, sans-serif",
        "font-size": "14px",
        "font-size-lg": "20px",
        "font-size-sm": "12px",
        "font-weight-bold": "600",
        "info": "#8ab4f8",
        "info-fg": "#202124",
        "line-height": "1.5",
        "muted": "#bdc1c6",
        "radius": "8px",
        "radius-lg": "16px",
        "radius-sm": "4px",
        "shadow": "0 1px 2px rgba(0,0,0,0.45)",
        "spacing": "8px",
        "spacing-lg": "16px",
        "spacing-sm": "4px",
        "success": "#81c995",
        "success-fg": "#202124",
        "surface": "#292a2d",
        "warning": "#fdd663",
        "warning-fg": "#202124"
      }
    },
    {
      "description": "A bright, clean theme inspired by Google's blue, red, yellow, and green palette.",
      "label": "Google-inspired light",
      "name": "google-light",
      "tokens": {
        "accent": "#1a73e8",
        "accent-fg": "#ffffff",
        "bg": "#f8fafd",
        "border": "#dadce0",
        "border-width": "1px",
        "danger": "#d93025",
        "danger-fg": "#ffffff",
        "fg": "#202124",
        "font-family": "Google Sans, Roboto, Arial, sans-serif",
        "font-size": "14px",
        "font-size-lg": "20px",
        "font-size-sm": "12px",
        "font-weight-bold": "600",
        "info": "#1a73e8",
        "info-fg": "#ffffff",
        "line-height": "1.5",
        "muted": "#5f6368",
        "radius": "8px",
        "radius-lg": "16px",
        "radius-sm": "4px",
        "shadow": "0 1px 2px rgba(60,64,67,0.2)",
        "spacing": "8px",
        "spacing-lg": "16px",
        "spacing-sm": "4px",
        "success": "#188038",
        "success-fg": "#ffffff",
        "surface": "#ffffff",
        "warning": "#f9ab00",
        "warning-fg": "#202124"
      }
    }
  ],
  "widgets": [
    {
      "kind": "appointment-agenda-widget",
      "template": {
        "attrs": {
          "class": "wg-agenda"
        },
        "children": [
          {
            "children": [
              {
                "children": [
                  "Agenda"
                ],
                "tag": "h2"
              },
              {
                "template": {
                  "attrs": {
                    "class": "wg-muted"
                  },
                  "children": [
                    {
                      "bind": "date"
                    }
                  ],
                  "tag": "p"
                },
                "when": "date"
              }
            ],
            "tag": "header"
          },
          {
            "each": "appointments",
            "empty": {
              "attrs": {
                "class": "wg-muted"
              },
              "children": [
                "No appointments."
              ],
              "tag": "p"
            },
            "template": {
              "attrs": {
                "class": "wg-agenda-item"
              },
              "children": [
                {
                  "children": [
                    {
                      "bind": "title"
                    }
                  ],
                  "tag": "h3"
                },
                {
                  "attrs": {
                    "class": "wg-agenda-time"
                  },
                  "children": [
                    {
                      "bind": "startsAt",
                      "format": {
                        "pattern": "yyyy-MM-dd HH:ss",
                        "type": "date"
                      }
                    },
                    " — ",
                    {
                      "bind": "endsAt",
                      "format": {
                        "pattern": "yyyy-MM-dd HH:ss",
                        "type": "date"
                      }
                    }
                  ],
                  "tag": "p"
                },
                {
                  "template": {
                    "attrs": {
                      "class": "wg-muted"
                    },
                    "children": [
                      {
                        "bind": "location"
                      }
                    ],
                    "tag": "p"
                  },
                  "when": "location"
                },
                {
                  "template": {
                    "attrs": {
                      "class": "wg-agenda-link",
                      "href": {
                        "bind": "meetingUrl"
                      }
                    },
                    "children": [
                      "Join meeting"
                    ],
                    "tag": "a"
                  },
                  "when": "meetingUrl"
                },
                {
                  "template": {
                    "children": [
                      {
                        "each": "attendees",
                        "template": {
                          "children": [
                            {
                              "else": {
                                "bind": "name"
                              },
                              "template": {
                                "attrs": {
                                  "href": {
                                    "bind": "email",
                                    "prefix": "mailto:"
                                  }
                                },
                                "children": [
                                  {
                                    "bind": "name"
                                  }
                                ],
                                "tag": "a"
                              },
                              "when": "email"
                            }
                          ],
                          "tag": "li"
                        }
                      }
                    ],
                    "tag": "ul"
                  },
                  "when": "attendees"
                }
              ],
              "tag": "article"
            }
          }
        ],
        "tag": "section"
      },
      "descriptor": {
        "dataExample": {
          "appointments": [
            {
              "attendees": [
                {
                  "email": "nora@example.com",
                  "name": "Nora Patel",
                  "response": "accepted"
                },
                {
                  "email": "sam@example.com",
                  "name": "Sam Lee",
                  "response": "tentative"
                }
              ],
              "endsAt": "2026-09-03T10:00:45",
              "id": "a-101",
              "location": "Conference Room A",
              "meetingUrl": "https://meet.example.com/product-planning",
              "startsAt": "2026-09-03T09:15:30",
              "status": "confirmed",
              "title": "Product planning"
            },
            {
              "attendees": [
                {
                  "email": "alex@example.com",
                  "name": "Alex Kim",
                  "response": "accepted"
                }
              ],
              "endsAt": "2026-09-03T14:50:20",
              "id": "a-102",
              "location": "Studio 3",
              "startsAt": "2026-09-03T14:05:00",
              "status": "tentative",
              "title": "Design review"
            }
          ],
          "date": "2026-09-03",
          "timezone": "America/Bogota"
        },
        "dataSchemaRef": "appointment-agenda",
        "dataShape": "{ date?, timezone?, appointments: [{ id, title, startsAt, endsAt, location?, meetingUrl?, description?, status, attendees?: [{ name, email?, response? }] }] }",
        "description": "Displays a day agenda with formatted appointment times, attendance, and email links for attendees.",
        "styles": {
          ".wg-agenda": {
            "background": "var(--wg-surface)",
            "border": "var(--wg-border-width) solid var(--wg-border)",
            "border-radius": "var(--wg-radius-lg)",
            "padding": "var(--wg-spacing-lg)"
          },
          ".wg-agenda-item": {
            "border-top": "var(--wg-border-width) solid var(--wg-border)",
            "padding": "var(--wg-spacing)"
          },
          ".wg-agenda-link": {
            "color": "var(--wg-accent)"
          },
          ".wg-agenda-time": {
            "color": "var(--wg-muted)"
          }
        }
      }
    },
    {
      "kind": "email-inbox-widget",
      "template": {
        "attrs": {
          "class": "wg-inbox"
        },
        "children": [
          {
            "children": [
              {
                "children": [
                  "Inbox"
                ],
                "tag": "h2"
              },
              {
                "template": {
                  "attrs": {
                    "class": "wg-muted"
                  },
                  "children": [
                    {
                      "bind": "account"
                    }
                  ],
                  "tag": "p"
                },
                "when": "account"
              }
            ],
            "tag": "header"
          },
          {
            "each": "messages",
            "empty": {
              "attrs": {
                "class": "wg-muted"
              },
              "children": [
                "No messages."
              ],
              "tag": "p"
            },
            "template": {
              "attrs": {
                "class": "wg-inbox-email"
              },
              "children": [
                {
                  "attrs": {
                    "class": "wg-inbox-sender",
                    "href": {
                      "bind": "from",
                      "prefix": "mailto:"
                    }
                  },
                  "children": [
                    {
                      "bind": "from"
                    }
                  ],
                  "tag": "a"
                },
                {
                  "children": [
                    {
                      "bind": "subject"
                    }
                  ],
                  "tag": "h3"
                },
                {
                  "template": {
                    "attrs": {
                      "class": "wg-muted"
                    },
                    "children": [
                      {
                        "bind": "preview"
                      }
                    ],
                    "tag": "p"
                  },
                  "when": "preview"
                },
                {
                  "attrs": {
                    "class": "wg-muted"
                  },
                  "children": [
                    {
                      "bind": "receivedAt",
                      "format": {
                        "pattern": "yyyy-MM-dd HH:ss",
                        "type": "date"
                      }
                    }
                  ],
                  "tag": "small"
                }
              ],
              "tag": "article"
            }
          }
        ],
        "tag": "section"
      },
      "descriptor": {
        "dataExample": {
          "account": "alex@example.com",
          "messages": [
            {
              "from": "nora@example.com",
              "id": "m-101",
              "isRead": false,
              "isStarred": true,
              "labels": [
                "Work"
              ],
              "preview": "The latest draft is ready for review.",
              "receivedAt": "2026-09-03T09:15:30",
              "subject": "Project update"
            },
            {
              "from": "team@example.com",
              "id": "m-102",
              "isRead": false,
              "isStarred": false,
              "labels": [
                "Planning"
              ],
              "preview": "Here are the topics for our weekly planning session.",
              "receivedAt": "2026-09-03T08:30:00",
              "subject": "Friday agenda"
            }
          ],
          "unreadCount": 2
        },
        "dataSchemaRef": "email-inbox",
        "dataShape": "{ account?, unreadCount?, messages: [{ id, from, subject, preview?, receivedAt, isRead, isStarred?, labels? }] }",
        "description": "Displays an email inbox as a readable list, with each sender address as an email link.",
        "styles": {
          ".wg-inbox": {
            "background": "var(--wg-surface)",
            "border": "var(--wg-border-width) solid var(--wg-border)",
            "border-radius": "var(--wg-radius-lg)",
            "padding": "var(--wg-spacing-lg)"
          },
          ".wg-inbox-email": {
            "border-top": "var(--wg-border-width) solid var(--wg-border)",
            "padding": "var(--wg-spacing)"
          },
          ".wg-inbox-sender": {
            "color": "var(--wg-accent)"
          }
        }
      }
    }
  ]
}
