          "text-decoration": "line-through"
        },
        ".wg-item-cancelled .wg-date, .wg-item-cancelled .wg-muted": {
          "opacity": "0.7"
        },
        ".wg-card-field-value .wg-link": {
          "font-weight": "inherit"
        },
        ".wg-table-cell .wg-link[href^=\"tel:\"], .wg-table-cell .wg-link[href^=\"mailto:\"]": {
          "white-space": "nowrap"
        },
        ".wg-table-row:last-child .wg-table-cell": {
          "border-bottom": "0"
        },
        ".wg-chip-no .wg-link": {
          "color": "var(--wg-muted)"
        },
        ".wg-table-cell": {
          "vertical-align": "top"
        },
        ".wg-table-cell:first-child": {
          "min-width": "8em"
        }
      }
    },
