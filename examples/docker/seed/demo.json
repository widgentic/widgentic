        ".wg-card-field-key": {
          "flex": "0 0 8.5em",
          "font-size": "var(--wg-font-size-sm)",
          "letter-spacing": "0.02em",
          "overflow-wrap": "anywhere"
        },
        ".wg-card-field-value": {
          "min-width": "0",
          "overflow-wrap": "anywhere",
          "font-weight": "var(--wg-font-weight-bold)",
          "font-variant-numeric": "tabular-nums"
