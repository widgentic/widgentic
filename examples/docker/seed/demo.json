{
  "schemas": [
    {
      "name": "appointment-agenda",
      "label": "Appointment agenda",
      "description": "A dated agenda containing scheduled appointments, participants, locations, and attendance state.",
      "schema": {
        "properties": {
          "appointments": {
            "items": {
              "properties": {
                "attendees": {
                  "items": {
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "response": {
                        "enum": [
                          "accepted",
                          "declined",
                          "tentative",
                          "needsAction"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "description": {
                  "type": "string"
                },
                "endsAt": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "meetingUrl": {
                  "type": "string"
                },
                "startsAt": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "confirmed",
                    "tentative",
                    "cancelled"
                  ],
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "startsAt",
                "endsAt",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "date": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "appointments"
        ],
        "type": "object"
      }
    },
    {
      "name": "email-inbox",
      "label": "Email inbox",
      "description": "A mailbox with account context and an ordered collection of email messages.",
      "schema": {
        "properties": {
          "account": {
            "type": "string"
          },
          "messages": {
            "items": {
              "properties": {
                "from": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "isRead": {
                  "type": "boolean"
                },
                "isStarred": {
                  "type": "boolean"
                },
                "labels": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "preview": {
                  "type": "string"
                },
                "receivedAt": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "from",
                "subject",
                "receivedAt",
                "isRead"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "unreadCount": {
            "type": "integer"
          }
        },
        "required": [
          "messages"
        ],
        "type": "object"
      }
    }
  ],
  "themes": [
    {
      "name": "google-light",
