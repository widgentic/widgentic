{
  "name": "@widgentic-examples/docker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-hosted widgentic: one image, two services (authoring app + MCP endpoint) over one SQLite file. Copy this folder, `docker compose up`, author widgets, connect an agent host.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "node --disable-warning=ExperimentalWarning ./node_modules/.bin/tsx web.ts",
    "mcp": "node --disable-warning=ExperimentalWarning ./node_modules/.bin/tsx mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@widgentic-examples/mcp-server": "file:../mcp-server",
    "@widgentic-examples/shared": "file:../shared",
    "@widgentic/core": "^0.1.0",
    "@widgentic/designer": "^0.3.0",
    "@widgentic/mcp": "^0.4.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  }
}
