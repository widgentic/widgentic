# Copy to .env (compose reads it) or export in your shell. No values here —
# every setting is optional except the KEK if you want secrets.

# Path of the SQLite database file (the compose file mounts a volume at /data).
# WIDGENTIC_DB=/data/widgentic.db

# Key-encryption key for stored secrets: 64 hex characters, generated ONCE
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Prefer WIDGENTIC_KEK_FILE (a mounted file or docker secret, chmod 600) over
# the plain variable — never bake it into an image layer or commit it. Anyone
# who can read this material can decrypt every secret this deployment stores.
# Losing it makes stored secrets unreadable; there is no recovery.
# WIDGENTIC_KEK_FILE=/run/secrets/widgentic-kek
# WIDGENTIC_KEK=

# Multi-user mode: the request header a trusted auth proxy sets to the
# verified username. Unset = single principal, no sign-in (localhost use).
# Once set, requests WITHOUT the header are refused, and your proxy must
# strip the header from inbound client requests.
# WIDGENTIC_TRUSTED_USER_HEADER=x-forwarded-user

# Ports (compose maps them 1:1).
# WIDGENTIC_WEB_PORT=8080
# WIDGENTIC_MCP_PORT=8081

# Per-principal execute_action / test-call budget per minute (default 60).
# WIDGENTIC_EXECUTE_RATE=60

# Per-principal preview_widget budget per minute (default 240): streaming
# previews of stored widgets, and the theme CSS a streamed built-in render
# asks for.
# WIDGENTIC_PREVIEW_RATE=240

# Largest request body the mcp service reads, in bytes (default 4 MiB); a
# larger one is refused with 413.
# WIDGENTIC_MAX_BODY_BYTES=4194304

# Single origin (web service): forward /mcp to the MCP service.
# WIDGENTIC_MCP_UPSTREAM=http://mcp:8081

# The endpoint the Keys section shows (web service), when it is neither this
# origin's /mcp nor http://<host>:8081/mcp.
# WIDGENTIC_MCP_PUBLIC_URL=https://mcp.example.com/mcp

# A Chrome origin-trial token for WebMCP on your origin (web service).
# WIDGENTIC_ORIGIN_TRIAL_TOKEN=

# Sample entries loaded into the single principal at boot (web service);
# entries you already hold are never overwritten, but a seeded entry you
# delete comes back on restart. The image ships one:
# WIDGENTIC_SEED_FILE=/srv/docker/seed/demo.json

# A fixed API key for the single principal (mcp service) that survives an
# empty store; file preferred, `wgk_` + 64 hex. Read-only unless the scopes
# name execute. Treat it like any key.
# WIDGENTIC_DEFAULT_KEY_FILE=/run/secrets/widgentic-default-key
# WIDGENTIC_DEFAULT_KEY_SCOPES=read,execute
