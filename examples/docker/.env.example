# Copy to .env (compose reads it) or export in your shell. No values here —
# every setting is optional except the KEK if you want secrets.

# Path of the SQLite database file (the compose file mounts a volume at /data).
# WIDGENTIC_DB=/data/widgentic.db

# Key-encryption key for stored secrets: 64 hex characters, generated ONCE
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Prefer WIDGENTIC_KEK_FILE (a mounted file or docker secret, chmod 600) over
# the plain variable — never bake it into an image layer or commit it. Anyone
# who can read this material can decrypt every secret this deployment stores.
# Losing it makes stored secrets unreadable; there is no recovery.
# WIDGENTIC_KEK_FILE=/run/secrets/widgentic-kek
# WIDGENTIC_KEK=

# Multi-user mode: the request header a trusted auth proxy sets to the
# verified username. Unset = single principal, no sign-in (localhost use).
# Once set, requests WITHOUT the header are refused, and your proxy must
# strip the header from inbound client requests.
# WIDGENTIC_TRUSTED_USER_HEADER=x-forwarded-user

# Ports (compose maps them 1:1).
# WIDGENTIC_WEB_PORT=8080
# WIDGENTIC_MCP_PORT=8081

# Per-principal execute_action / test-call budget per minute (default 60).
# WIDGENTIC_EXECUTE_RATE=60
