{
  "name": "@widgentic/core",
  "version": "0.0.0",
  "description": "Widgets for agents \u2014 the widgentic engine: contract, adapters, mapper, catalog, theming, templates, actions and reactive rendering.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./mapper": {
      "types": "./dist/mapper/index.d.ts",
      "default": "./dist/mapper/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./theming": {
      "types": "./dist/theming/index.d.ts",
      "default": "./dist/theming/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./reactive": {
      "types": "./dist/reactive/index.d.ts",
      "default": "./dist/reactive/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegohoyos/widgentic.git",
    "directory": "packages/core"
  },
  "homepage": "https://widgentic.dev",
  "keywords": [
    "widgentic",
    "widgets",
    "mcp",
    "agents"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  }
}
