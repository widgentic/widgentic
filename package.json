{
  "name": "widgentic",
  "version": "0.0.0",
  "private": true,
  "description": "Widgets for agents \u2014 generic UI for MCP skills/plugins.",
  "type": "module",
  "main": "./src/contract/index.ts",
  "types": "./src/contract/index.ts",
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./mapper": "./src/mapper/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./reactive": "./src/reactive/index.ts",
    "./templates": "./src/templates/index.ts",
    "./theming": "./src/theming/index.ts",
    "./mcp-server": "./src/mcp-server/index.ts",
    "./designer": "./src/designer/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:types": "vitest --typecheck.only run",
    "test:watch": "vitest",
    "mcp": "tsx examples/mcp-server/main.ts",
    "mcp:http": "tsx examples/mcp-server/http.ts",
    "designer": "tsx examples/designer/serve.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "happy-dom": "20.11.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
