{
  "name": "widgentic-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Widgets for agents \u2014 workspace root: public packages under packages/, sample hosts under examples/.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:types": "vitest --typecheck.only run",
    "test:watch": "vitest",
    "build": "npm run build -w @widgentic/core && npm run build -w @widgentic/designer && npm run build -w @widgentic/mcp",
    "pack:check": "node tools/pack-check.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "mcp": "tsx examples/mcp-server/main.ts",
    "designer": "tsx examples/designer/serve.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@azure/cosmos": "^4.10.0",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-keys": "^4.10.2",
    "@changesets/cli": "^2.29.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "happy-dom": "20.11.1",
    "publint": "^0.3.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
