{
  "name": "widgentic",
  "version": "0.0.0",
  "private": true,
  "description": "Widgets for agents — generic UI for MCP skills/plugins.",
  "type": "module",
  "main": "./src/contract/index.ts",
  "types": "./src/contract/index.ts",
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./mapper": "./src/mapper/index.ts",
    "./catalog": "./src/catalog/index.ts",
