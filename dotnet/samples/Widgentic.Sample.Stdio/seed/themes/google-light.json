{
  "name": "google-light",
  "label": "Google-inspired light",
  "description": "A bright, clean theme inspired by Google's blue, red, yellow, and green palette.",
  "tokens": {
    "accent": "#1a73e8",
    "accent-fg": "#ffffff",
    "bg": "#f8fafd",
    "border": "#dadce0",
    "border-width": "1px",
    "danger": "#d93025",
    "danger-fg": "#ffffff",
    "fg": "#202124",
    "font-family": "Google Sans, Roboto, Arial, sans-serif",
    "font-size": "14px",
    "font-size-lg": "20px",
    "font-size-sm": "12px",
    "font-weight-bold": "600",
    "info": "#1a73e8",
    "info-fg": "#ffffff",
    "line-height": "1.5",
    "muted": "#5f6368",
    "radius": "8px",
    "radius-lg": "16px",
    "radius-sm": "4px",
    "shadow": "0 1px 2px rgba(60,64,67,0.2)",
    "spacing": "8px",
    "spacing-lg": "16px",
    "spacing-sm": "4px",
    "success": "#188038",
    "success-fg": "#ffffff",
    "surface": "#ffffff",
    "warning": "#f9ab00",
    "warning-fg": "#202124",
    "x-tint": "#f1f3f4",
    "x-hover": "#e8f0fe"
  },
  "styles": {
    ".wg-panel": {
      "background": "var(--wg-surface)",
      "border": "var(--wg-border-width) solid var(--wg-border)",
      "border-radius": "var(--wg-radius-lg)",
      "box-shadow": "var(--wg-shadow)",
      "padding": "var(--wg-spacing-lg)",
      "font-family": "var(--wg-font-family)",
      "font-size": "var(--wg-font-size)",
      "line-height": "var(--wg-line-height)",
      "color": "var(--wg-fg)"
    },
    ".wg-panel-head": {
      "display": "flex",
      "align-items": "baseline",
      "justify-content": "space-between",
      "flex-wrap": "wrap",
      "gap": "var(--wg-spacing)",
      "margin-bottom": "var(--wg-spacing)"
    },
    ".wg-title": {
      "margin": "0",
      "font-size": "var(--wg-font-size-lg)",
      "font-weight": "var(--wg-font-weight-bold)",
      "color": "var(--wg-fg)"
    },
    ".wg-subtitle": {
      "display": "flex",
      "align-items": "center",
      "gap": "var(--wg-spacing-sm)",
      "margin": "0",
      "font-size": "var(--wg-font-size)",
      "font-weight": "var(--wg-font-weight-bold)",
      "color": "var(--wg-fg)"
    },
    ".wg-muted": {
      "margin": "0",
      "color": "var(--wg-muted)",
      "font-size": "var(--wg-font-size-sm)"
    },
    ".wg-date": {
      "margin": "0",
      "color": "var(--wg-muted)",
      "font-size": "var(--wg-font-size-sm)",
      "font-variant-numeric": "tabular-nums",
      "letter-spacing": "0.02em"
    },
    ".wg-link": {
      "color": "var(--wg-accent)",
      "text-decoration": "none",
      "font-weight": "500"
    },
    ".wg-link:hover, .wg-link:focus-visible": {
      "text-decoration": "underline"
    },
    ".wg-item": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "var(--wg-spacing-sm)",
      "border-top": "var(--wg-border-width) solid var(--wg-border)",
      "padding": "var(--wg-spacing) 0"
    },
    ".wg-item:first-of-type": {
      "border-top": "0"
    },
    ".wg-unread": {
      "box-shadow": "inset 3px 0 0 var(--wg-accent)",
      "padding-left": "var(--wg-spacing)"
    },
    ".wg-unread .wg-subtitle": {
      "color": "var(--wg-accent)"
    },
    ".wg-list": {
      "display": "flex",
      "flex-wrap": "wrap",
      "gap": "var(--wg-spacing-sm)",
      "margin": "0",
      "padding": "0",
      "list-style": "none"
    },
    ".wg-chip": {
      "display": "inline-flex",
      "align-items": "center",
      "padding": "0 var(--wg-spacing)",
      "border-radius": "999px",
      "border": "var(--wg-border-width) solid var(--wg-border)",
      "background": "var(--wg-x-tint, var(--wg-bg))",
      "font-size": "var(--wg-font-size-sm)",
      "line-height": "1.8"
    },
    ".wg-chip-yes": {
      "border-color": "var(--wg-success)"
    },
    ".wg-chip-maybe": {
      "border-color": "var(--wg-warning)",
      "border-style": "dashed"
    },
    ".wg-card": {
      "border-top": "calc(var(--wg-border-width) * 4) solid var(--wg-accent)"
    },
    ".wg-card-title": {
      "color": "var(--wg-fg)",
      "letter-spacing": "-0.01em"
    },
    ".wg-card-field": {
      "border-bottom": "var(--wg-border-width) dashed var(--wg-border)"
    },
    ".wg-card-field:last-child": {
      "border-bottom": "0"
    },
    ".wg-card-field-key": {
      "min-width": "6em",
      "text-transform": "uppercase",
      "font-size": "var(--wg-font-size-sm)",
      "letter-spacing": "0.06em"
    },
    ".wg-card-field-value": {
      "font-weight": "var(--wg-font-weight-bold)",
      "font-variant-numeric": "tabular-nums"
    },
    ".wg-table": {
      "width": "100%",
      "box-shadow": "var(--wg-shadow)"
    },
    ".wg-table-title": {
      "color": "var(--wg-fg)"
    },
    ".wg-table-header": {
      "background": "var(--wg-x-tint, var(--wg-bg))",
      "text-transform": "uppercase",
      "letter-spacing": "0.06em"
    },
    ".wg-table-row:nth-child(even) .wg-table-cell": {
      "background": "var(--wg-x-tint, var(--wg-bg))"
    },
    ".wg-table-row:hover .wg-table-cell": {
      "background": "var(--wg-x-hover, var(--wg-bg))"
    }
  }
}
