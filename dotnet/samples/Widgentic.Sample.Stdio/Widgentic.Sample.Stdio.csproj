<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Widgentic.Sample.Stdio</RootNamespace>
    <!-- [McpAppUi] belongs to the C# SDK's experimental MCP Apps extension. -->
    <NoWarn>$(NoWarn);MCPEXP003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <ProjectReference Include="../../src/Widgentic.Mcp/Widgentic.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from examples/mcp-server/widgets by `npm run conformance:generate`; never hand-edited. -->
    <None Include="widgets/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
